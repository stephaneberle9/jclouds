<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.apache.jclouds</groupId>
        <artifactId>jclouds-project</artifactId>
        <version>${revision}</version>
        <relativePath>../../project/pom.xml</relativePath>
    </parent>

    <groupId>org.apache.jclouds.common</groupId>
    <artifactId>aws</artifactId>
    <name>jclouds AWS Common</name>
    <description>jclouds components common to AWS products</description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${awssdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.apache.jclouds.api</groupId>
            <artifactId>sts</artifactId>
            <version>${project.version}</version>
            <type>jar</type>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>auth</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>regions</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.apache.jclouds</groupId>
            <artifactId>jclouds-core</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <executions>
            <!-- *InstanceMetadataTest classes change JVM-wide system properties (the instance
                 metadata endpoint, the profile files, aws.region); they must not share a JVM
                 with tests running in parallel: keep them out of the parallel default-test run
                 (and only that one, so the parent's integration execution is unaffected) and run
                 them alone in the instance-metadata execution below -->
            <execution>
              <id>default-test</id>
              <configuration>
                <excludes combine.children="append">
                  <exclude>**/*InstanceMetadataTest.java</exclude>
                </excludes>
              </configuration>
            </execution>
            <execution>
              <id>instance-metadata</id>
              <phase>test</phase>
              <goals>
                <goal>test</goal>
              </goals>
              <configuration>
                <threadCount>1</threadCount>
                <includes combine.self="override">
                  <include>**/*InstanceMetadataTest.java</include>
                </includes>
                <excludes combine.self="override">
                  <exclude>**/*IntegrationTest.java</exclude>
                  <exclude>**/*LiveTest.java</exclude>
                </excludes>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </build>
</project>
